# ============================================================
# Nginx 部署配置模板
#
# 使用方法：
#   cp env.example env
#   vim env
#   sudo ./install_nginx.sh
#
# 说明：
#   - install_nginx.sh 会自动加载脚本同目录下的 env 文件
#   - env 包含你的实际域名/证书路径，已加入 .gitignore，请勿提交
#   - 也可通过 ENV_FILE=/path/to/env 指定其他配置文件
# ============================================================

# ===================== 供应链安全校验（生产必填） =====================
# 1=严格模式：任一哈希/commit缺失即终止；0=仅警告（测试环境）
STRICT_SUPPLYCHAIN=1

# 证书 SAN 严格校验：1=SAN 未覆盖目标域名时拒绝执行；0=仅告警
STRICT_CERT_SAN=1

# ===================== 版本覆盖（升级时同步更新下方哈希/commit） =====================
# 默认值写在脚本内，可按需覆盖。升级版本后必须同步更新对应 SHA256 或 commit pin。
# NGINX_VER=1.31.8
# JEMALLOC_VER=5.4.0
# FANCYINDEX_VER=0.6.0
# DAV_EXT_VER=3.0.0
# HEADERS_MORE_VER=0.41
# OPENSSL_VER=3.5.9
# NGX_BROTLI_REF=v1.0.0rc

# Tarball SHA256（必须与下载版本完全匹配）
NGINX_TARBALL_SHA256=0652b760b3b772d2ec17b47c2fc15d9a95e6fe35cd5b877eadc1a62d9bc75af1
OPENSSL_TARBALL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
JEMALLOC_TARBALL_SHA256=200776fac271093e7c2f21edd6d62657ecd2be578d9328633f2a86bfa6ef4f1d
FANCYINDEX_TARBALL_SHA256=d212fdc1393261612126def3e091c376adeda5646130b4240093f47b550bc5ef
DAV_EXT_TARBALL_SHA256=d2499d94d82d4e4eac8425d799e52883131ae86a956524040ff2fd230ef9f859
HEADERS_MORE_TARBALL_SHA256=800eba641c29b89dfd00a97ccac314a2b7768bdd85ea37ed819452494a5633cd

# Git commit pin（建议固定）
NGX_BROTLI_COMMIT=25f86f0bac1101b6512135eac5f93c49c63609e3

# ===================== 部署模式 =====================
# 1=全程无交互；0=缺失参数时交互输入
NON_INTERACTIVE=1
# 安装失败是否自动回滚：1=回滚到未安装状态；0=保留现场排障
ROLLBACK_ON_ERROR=1

# ===================== 站点域名（示例：abc.com） =====================
MAIN_DOMAIN=main.abc.com
DAV_DOMAIN=dav.abc.com
API_DOMAIN=api.abc.com
TUN_DOMAIN=tun.abc.com

# ===================== 证书路径（源路径，示例值请替换为实际路径） =====================
# 主站证书与私钥（必填）
MAIN_CERT_SRC=/etc/letsencrypt/abc.com/fullchain.cer
MAIN_KEY_SRC=/etc/letsencrypt/abc.com/abc.com.key
# WebDAV 证书与私钥（可留空，按复用策略继承主站）
DAV_CERT_SRC=
DAV_KEY_SRC=

# API 证书与私钥（可留空，按复用策略继承主站）
API_CERT_SRC=
API_KEY_SRC=

# TUN（Tunnel）证书与私钥（可留空，按复用策略继承主站）
TUN_CERT_SRC=
TUN_KEY_SRC=

# 证书复用策略：1=未显式提供时复用主站证书；0=必须单独提供
DAV_REUSE_MAIN_CERT=1
API_REUSE_MAIN_CERT=1
TUN_REUSE_MAIN_CERT=1

# TUN（Tunnel）/vless 反代上游地址（示例：xray ws 入站）
VLESS_UPSTREAM=http://127.0.0.1:10000

# ===================== HTTP/3 (QUIC) =====================
# 1=启用 Nginx HTTP/3；0=不监听 UDP（适用于其他应用占用 443/udp）
HTTP3_ENABLE=0
# Nginx QUIC 监听端口；若 443/udp 被其他应用占用，可改为 8443 等
# 修改后需同步放行防火墙 UDP 端口，并更新客户端访问方式（Alt-Svc 会自动使用该端口）
HTTP3_PORT=443

# ===================== WebDAV 防爆破模板（仅生成模板，不自动安装） =====================
# 1=生成 fail2ban 模板；0=不生成
ENABLE_FAIL2BAN_TEMPLATE=0
# 连续失败次数达到阈值后触发封禁
F2B_MAXRETRY=6
# 统计窗口
F2B_FINDTIME=10m
# 封禁时长
F2B_BANTIME=12h
# 白名单（管理网段/本机）
F2B_IGNOREIP="127.0.0.1/8 ::1"

# ===================== 编译缓存清理 =====================
# 1=安装成功后清理 /usr/local/src 下本脚本下载的源码与压缩包；0=保留
CLEAN_BUILD_ARTIFACTS=1

# ===================== 卸载相关（通常不需要预设） =====================
# 强制卸载开关：1=跳过二次确认；0=保持人工确认
FORCE_UNINSTALL=0
# 卸载保留网站目录：1=保留 /var/www；0=删除 /var/www
PRESERVE_WWW=0
